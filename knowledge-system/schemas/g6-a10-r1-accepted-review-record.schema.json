{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/g6-a10-r1-accepted-review-record.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "reviewId", "gateId", "roleId", "assignee", "releaseId", "siteDigest", "publicReceiptSha256", "artifactManifestSha256", "assignedAt", "independenceAttestation", "state", "decision", "signedAt", "timestampProvenance", "evidenceRefs", "reviewItems", "findings"],
  "properties": {
    "$schema": { "type": "string", "minLength": 3 },
    "schemaVersion": { "const": 1 },
    "reviewId": { "type": "string", "pattern": "^G6-A10-REVIEW-ROLE-[A-Z0-9-]+$" },
    "gateId": { "const": "G6-A10-R1" },
    "roleId": { "enum": ["ROLE-PRODUCT-CONTENT", "ROLE-AMAZON-ADS-DOMAIN", "ROLE-ENGINEERING-TEST", "ROLE-SECURITY-RELEASE"] },
    "assignee": { "enum": ["pray", "ll", "zy", "ly"] },
    "releaseId": { "const": "mkd-m1c-438e6ae583fc952d" },
    "siteDigest": { "const": "sha256:438e6ae583fc952d813908b53a6c886ef127dad56d1a73eb017151f1f38bfadf" },
    "publicReceiptSha256": { "const": "7f0fb9eec51f18385a69046a254749ffee071aecfcd8678a96b9dd8c9c3000d3" },
    "artifactManifestSha256": { "const": "2f7a5bec0ff5f7fb159748f55da5b163d374341eda8c1260800fd03502df8c75" },
    "assignedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "independenceAttestation": { "const": true },
    "state": { "const": "completed" },
    "decision": { "const": "accepted" },
    "signedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "timestampProvenance": {
      "type": "object",
      "required": ["mode", "recordedAt", "humanProvidedSignedAt", "meaning"],
      "properties": {
        "mode": { "const": "system-recorded-on-user-confirmation" },
        "recordedAt": { "type": "string" },
        "humanProvidedSignedAt": { "const": null },
        "meaning": { "const": "system processing time for the user's complete four-reviewer confirmation; not four separately handwritten timestamps" }
      },
      "additionalProperties": false
    },
    "evidenceRefs": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 3 }, "uniqueItems": true },
    "reviewItems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["check", "status", "note"],
        "properties": { "check": { "type": "string", "minLength": 12 }, "status": { "const": "passed" }, "note": { "const": null } },
        "additionalProperties": false
      }
    },
    "findings": { "type": "array", "maxItems": 0 }
  },
  "allOf": [
    { "if": { "properties": { "roleId": { "const": "ROLE-PRODUCT-CONTENT" } }, "required": ["roleId"] }, "then": { "properties": { "assignee": { "const": "pray" } } } },
    { "if": { "properties": { "roleId": { "const": "ROLE-AMAZON-ADS-DOMAIN" } }, "required": ["roleId"] }, "then": { "properties": { "assignee": { "const": "ll" } } } },
    { "if": { "properties": { "roleId": { "const": "ROLE-ENGINEERING-TEST" } }, "required": ["roleId"] }, "then": { "properties": { "assignee": { "const": "zy" } } } },
    { "if": { "properties": { "roleId": { "const": "ROLE-SECURITY-RELEASE" } }, "required": ["roleId"] }, "then": { "properties": { "assignee": { "const": "ly" } } } }
  ],
  "additionalProperties": false
}
