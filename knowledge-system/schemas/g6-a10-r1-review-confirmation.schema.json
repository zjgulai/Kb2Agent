{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/g6-a10-r1-review-confirmation.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "confirmationId", "gateId", "confirmedAt", "timestampPolicy", "subject", "reviewFacts", "authorizationBoundary"],
  "properties": {
    "$schema": { "type": "string", "minLength": 3 },
    "schemaVersion": { "const": 1 },
    "confirmationId": { "const": "G6-A10-R1-FOUR-ROLE-USER-CONFIRMATION" },
    "gateId": { "const": "G6-A10-R1" },
    "confirmedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "timestampPolicy": {
      "type": "object",
      "required": ["mode", "recordedAt", "localDisplay", "humanProvidedSignedAt", "meaning"],
      "properties": {
        "mode": { "const": "system-recorded-on-user-confirmation" },
        "recordedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        "localDisplay": { "type": "string", "minLength": 12 },
        "humanProvidedSignedAt": { "const": null },
        "meaning": { "const": "system processing time for the user's complete four-reviewer confirmation; not four separately handwritten timestamps" }
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["releaseId", "siteDigest", "publicReceiptSha256", "artifactManifestSha256"],
      "properties": {
        "releaseId": { "const": "mkd-m1c-438e6ae583fc952d" },
        "siteDigest": { "const": "sha256:438e6ae583fc952d813908b53a6c886ef127dad56d1a73eb017151f1f38bfadf" },
        "publicReceiptSha256": { "const": "7f0fb9eec51f18385a69046a254749ffee071aecfcd8678a96b9dd8c9c3000d3" },
        "artifactManifestSha256": { "const": "2f7a5bec0ff5f7fb159748f55da5b163d374341eda8c1260800fd03502df8c75" }
      },
      "additionalProperties": false
    },
    "reviewFacts": {
      "type": "object",
      "required": ["source", "acceptedReviewers", "distinctReviewers", "reviewers"],
      "properties": {
        "source": { "const": "user-confirmed-in-codex-task" },
        "acceptedReviewers": { "const": 4 },
        "distinctReviewers": { "const": 4 },
        "reviewers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/prayReview" },
            { "$ref": "#/$defs/llReview" },
            { "$ref": "#/$defs/zyReview" },
            { "$ref": "#/$defs/lyReview" }
          ],
          "items": false
        }
      },
      "additionalProperties": false
    },
    "authorizationBoundary": {
      "type": "object",
      "required": ["localDecisionMaterializationAuthorized", "publicOrRemoteReadAuthorized", "remoteMutationAuthorized", "dockerAuthorized", "productionAgentAuthorized", "providerCallsAuthorized", "externalWritesAuthorized", "commitAuthorized", "pushAuthorized"],
      "properties": {
        "localDecisionMaterializationAuthorized": { "const": true },
        "publicOrRemoteReadAuthorized": { "const": false },
        "remoteMutationAuthorized": { "const": false },
        "dockerAuthorized": { "const": false },
        "productionAgentAuthorized": { "const": false },
        "providerCallsAuthorized": { "const": false },
        "externalWritesAuthorized": { "const": false },
        "commitAuthorized": { "const": false },
        "pushAuthorized": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "baseReview": {
      "type": "object",
      "required": ["roleId", "assignee", "threeChecks", "findings", "independenceAttestation", "decision"],
      "properties": {
        "roleId": { "type": "string" },
        "assignee": { "type": "string" },
        "threeChecks": { "const": "passed" },
        "findings": { "type": "array", "maxItems": 0 },
        "independenceAttestation": { "const": true },
        "decision": { "const": "accepted" }
      },
      "additionalProperties": false
    },
    "prayReview": { "allOf": [{ "$ref": "#/$defs/baseReview" }, { "properties": { "roleId": { "const": "ROLE-PRODUCT-CONTENT" }, "assignee": { "const": "pray" } } }] },
    "llReview": { "allOf": [{ "$ref": "#/$defs/baseReview" }, { "properties": { "roleId": { "const": "ROLE-AMAZON-ADS-DOMAIN" }, "assignee": { "const": "ll" } } }] },
    "zyReview": { "allOf": [{ "$ref": "#/$defs/baseReview" }, { "properties": { "roleId": { "const": "ROLE-ENGINEERING-TEST" }, "assignee": { "const": "zy" } } }] },
    "lyReview": { "allOf": [{ "$ref": "#/$defs/baseReview" }, { "properties": { "roleId": { "const": "ROLE-SECURITY-RELEASE" }, "assignee": { "const": "ly" } } }] }
  },
  "additionalProperties": false
}
