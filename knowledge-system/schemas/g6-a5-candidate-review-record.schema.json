{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/g6-a5-candidate-review-record.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "reviewId",
    "gateId",
    "roleId",
    "assignee",
    "releaseId",
    "siteDigest",
    "archiveSha256",
    "assignedAt",
    "independenceAttestation",
    "state",
    "decision",
    "signedAt",
    "evidenceRefs",
    "reviewItems",
    "findings"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 3 },
    "schemaVersion": { "const": 1 },
    "reviewId": { "type": "string", "pattern": "^G6-A5-REVIEW-ROLE-[A-Z0-9-]+$" },
    "gateId": { "const": "G6-A5" },
    "roleId": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" },
    "assignee": { "type": "string", "minLength": 2 },
    "releaseId": { "const": "mkd-m1c-438e6ae583fc952d" },
    "siteDigest": { "const": "sha256:438e6ae583fc952d813908b53a6c886ef127dad56d1a73eb017151f1f38bfadf" },
    "archiveSha256": { "const": "39c46be06d37507bbb5c1470d531c80988c6bc46d1d332425b51170ff840a892" },
    "assignedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "independenceAttestation": { "type": ["boolean", "null"] },
    "state": { "enum": ["assigned", "completed"] },
    "decision": { "enum": ["pending", "accepted", "rejected"] },
    "signedAt": {
      "anyOf": [
        { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        { "type": "null" }
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "reviewItems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["check", "status", "note"],
        "properties": {
          "check": { "type": "string", "minLength": 12 },
          "status": { "enum": ["pending", "passed", "failed"] },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "assigned" } }, "required": ["state"] },
      "then": {
        "properties": {
          "independenceAttestation": { "const": null },
          "decision": { "const": "pending" },
          "signedAt": { "const": null },
          "reviewItems": {
            "items": {
              "properties": { "status": { "const": "pending" }, "note": { "const": null } }
            }
          },
          "findings": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "accepted" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "state": { "const": "completed" },
          "independenceAttestation": { "const": true },
          "signedAt": { "type": "string" },
          "reviewItems": { "items": { "properties": { "status": { "const": "passed" } } } }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "rejected" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "state": { "const": "completed" },
          "independenceAttestation": { "const": true },
          "signedAt": { "type": "string" },
          "reviewItems": { "contains": { "properties": { "status": { "const": "failed" } }, "required": ["status"] } }
        }
      }
    }
  ],
  "additionalProperties": false
}
