{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/g6-a10-public-evidence-review-submission.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "submissionId",
    "gateId",
    "releaseId",
    "siteDigest",
    "publicReceiptSha256",
    "artifactManifestSha256",
    "reviews"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 3 },
    "schemaVersion": { "const": 1 },
    "submissionId": { "type": "string", "pattern": "^G6-A10-SUBMISSION-[A-Z0-9-]+$" },
    "gateId": { "const": "G6-A10" },
    "releaseId": { "const": "mkd-m1c-438e6ae583fc952d" },
    "siteDigest": { "const": "sha256:438e6ae583fc952d813908b53a6c886ef127dad56d1a73eb017151f1f38bfadf" },
    "publicReceiptSha256": { "const": "7f0fb9eec51f18385a69046a254749ffee071aecfcd8678a96b9dd8c9c3000d3" },
    "artifactManifestSha256": { "const": "2f7a5bec0ff5f7fb159748f55da5b163d374341eda8c1260800fd03502df8c75" },
    "reviews": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["roleId", "assignee", "checkResults", "findings", "independenceAttestation", "decision", "signedAt"],
        "properties": {
          "roleId": { "enum": ["ROLE-PRODUCT-CONTENT", "ROLE-AMAZON-ADS-DOMAIN", "ROLE-ENGINEERING-TEST", "ROLE-SECURITY-RELEASE"] },
          "assignee": { "enum": ["pray", "ll", "zy", "ly"] },
          "checkResults": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "enum": ["passed", "failed"] }
          },
          "findings": { "type": "array", "items": { "type": "string", "minLength": 3 } },
          "independenceAttestation": { "const": true },
          "decision": { "enum": ["accepted", "rejected"] },
          "signedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
        },
        "allOf": [
          {
            "if": { "properties": { "roleId": { "const": "ROLE-PRODUCT-CONTENT" } }, "required": ["roleId"] },
            "then": { "properties": { "assignee": { "const": "pray" } } }
          },
          {
            "if": { "properties": { "roleId": { "const": "ROLE-AMAZON-ADS-DOMAIN" } }, "required": ["roleId"] },
            "then": { "properties": { "assignee": { "const": "ll" } } }
          },
          {
            "if": { "properties": { "roleId": { "const": "ROLE-ENGINEERING-TEST" } }, "required": ["roleId"] },
            "then": { "properties": { "assignee": { "const": "zy" } } }
          },
          {
            "if": { "properties": { "roleId": { "const": "ROLE-SECURITY-RELEASE" } }, "required": ["roleId"] },
            "then": { "properties": { "assignee": { "const": "ly" } } }
          },
          {
            "if": { "properties": { "decision": { "const": "accepted" } }, "required": ["decision"] },
            "then": { "properties": { "checkResults": { "items": { "const": "passed" } } } }
          },
          {
            "if": { "properties": { "decision": { "const": "rejected" } }, "required": ["decision"] },
            "then": { "properties": { "checkResults": { "contains": { "const": "failed" } } } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
