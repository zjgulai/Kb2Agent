{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/m1-c-review-acceptance.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "packetId",
    "reviewedAt",
    "subject",
    "state",
    "independenceRequired",
    "reviewers",
    "deploymentGate"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "packetId": { "type": "string", "pattern": "^MKD-M1-C-REVIEW-[A-Z0-9-]+$" },
    "reviewedAt": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["snapshotId", "snapshotHash", "qaReceipt", "crossAudit", "releaseManifest"],
      "properties": {
        "snapshotId": { "type": "string", "minLength": 8 },
        "snapshotHash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "qaReceipt": { "$ref": "#/$defs/fileEvidence" },
        "crossAudit": { "$ref": "#/$defs/fileEvidence" },
        "releaseManifest": {
          "anyOf": [
            { "$ref": "#/$defs/fileEvidence" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "state": { "enum": ["blocked-missing-assignments", "in-review", "accepted"] },
    "independenceRequired": { "const": true },
    "reviewers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "roleId",
          "scope",
          "requiredChecks",
          "assignee",
          "assignmentState",
          "decision",
          "signedAt",
          "evidenceRefs"
        ],
        "properties": {
          "roleId": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" },
          "scope": { "type": "string", "minLength": 12 },
          "requiredChecks": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "string", "minLength": 3 },
            "uniqueItems": true
          },
          "assignee": {
            "anyOf": [
              { "type": "string", "minLength": 2 },
              { "type": "null" }
            ]
          },
          "assignmentState": { "enum": ["unassigned", "assigned", "completed"] },
          "decision": { "enum": ["pending", "accepted", "rejected"] },
          "signedAt": {
            "anyOf": [
              { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
              { "type": "null" }
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": { "type": "string", "minLength": 3 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "deploymentGate": {
      "type": "object",
      "required": [
        "reviewAcceptancesRequired",
        "distinctAssigneesRequired",
        "candidateStaticDeployAllowed",
        "productionDeployAllowed",
        "reason"
      ],
      "properties": {
        "reviewAcceptancesRequired": { "const": 4 },
        "distinctAssigneesRequired": { "const": 4 },
        "candidateStaticDeployAllowed": { "type": "boolean" },
        "productionDeployAllowed": { "const": false },
        "reason": { "type": "string", "minLength": 12 }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
