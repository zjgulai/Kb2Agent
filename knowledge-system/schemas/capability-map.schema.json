{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/capability-map.schema.json",
  "type": "object",
  "required": ["$schema", "schemaVersion", "reviewedAt", "scopeNote", "evidenceCeiling", "capabilities"],
  "properties": {
    "$schema": { "const": "./schemas/capability-map.schema.json" },
    "schemaVersion": { "const": 1 },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scopeNote": { "type": "string", "minLength": 20 },
    "evidenceCeiling": { "type": "string", "minLength": 10 },
    "capabilities": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "name", "line", "status", "evidenceGrade", "deployment", "evidenceRefs", "ownerGate", "forbiddenClaims"],
        "properties": {
          "id": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$", "minLength": 8 },
          "name": { "type": "string", "minLength": 4 },
          "line": { "enum": ["GUIDE", "REFERENCE"] },
          "status": { "enum": ["live", "accepted", "replayable", "draft", "blocked", "design-only"] },
          "evidenceGrade": { "enum": ["L0", "L1", "LO-S", "L2", "L3", "L4"] },
          "deployment": { "enum": ["github-pages", "tencent-cloud", "both", "none"] },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["kind", "value"],
              "properties": {
                "kind": { "enum": ["path", "commit", "url"] },
                "value": { "type": "string", "minLength": 4 }
              },
              "additionalProperties": false
            }
          },
          "ownerGate": {
            "oneOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^G[0-9][A-Za-z0-9-]*$", "minLength": 4 }
            ]
          },
          "forbiddenClaims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 10 }
          },
          "notes": { "type": "string", "minLength": 5 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
