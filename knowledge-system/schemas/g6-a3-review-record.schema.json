{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/g6-a3-review-record.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "reviewId",
    "gateId",
    "roleId",
    "assignee",
    "candidateId",
    "candidateDigest",
    "assignedAt",
    "independenceAttestation",
    "state",
    "decision",
    "signedAt",
    "evidenceRefs",
    "reviewItems",
    "findings"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "reviewId": { "type": "string", "pattern": "^G6-A3-REVIEW-ROLE-[A-Z0-9-]+$" },
    "gateId": { "const": "G6-A3" },
    "roleId": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" },
    "assignee": { "type": "string", "minLength": 2 },
    "candidateId": { "const": "g6-a2-r1-local-remediation" },
    "candidateDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "assignedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "independenceAttestation": { "type": ["boolean", "null"] },
    "state": { "enum": ["assigned", "completed"] },
    "decision": { "enum": ["pending", "accepted", "rejected"] },
    "signedAt": {
      "anyOf": [
        { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
        { "type": "null" }
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "reviewItems": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["check", "status", "note"],
        "properties": {
          "check": { "type": "string", "minLength": 12 },
          "status": { "enum": ["pending", "passed", "failed"] },
          "note": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    }
  },
  "additionalProperties": false
}
