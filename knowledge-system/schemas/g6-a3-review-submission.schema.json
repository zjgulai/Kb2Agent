{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/g6-a3-review-submission.schema.json",
  "type": "object",
  "required": ["schemaVersion", "gateId", "source", "reviewers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gateId": { "const": "G6-A3" },
    "source": { "const": "user-provided-independent-review-results" },
    "reviewers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["roleId", "assignee", "checks", "findings", "independenceAttestation", "decision", "signedAt"],
        "properties": {
          "roleId": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" },
          "assignee": { "type": "string", "minLength": 2 },
          "checks": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["status", "note"],
              "properties": {
                "status": { "enum": ["passed", "failed"] },
                "note": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "findings": { "type": "array", "items": { "type": "string", "minLength": 3 } },
          "independenceAttestation": { "type": "boolean" },
          "decision": { "enum": ["accepted", "rejected"] },
          "signedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
