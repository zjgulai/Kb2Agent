{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/knowledge-system/g6-a5-candidate-review-packet.schema.json",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "packetId",
    "gateId",
    "preparedAt",
    "subject",
    "state",
    "independenceRequired",
    "reviewers",
    "authorizationBoundary"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 3 },
    "schemaVersion": { "const": 1 },
    "packetId": { "type": "string", "pattern": "^G6-A5-[A-Z0-9-]+$" },
    "gateId": { "const": "G6-A5" },
    "preparedAt": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "subject": {
      "type": "object",
      "required": ["releaseId", "siteDigest", "archiveSha256", "siteManifest", "diffManifest", "p9Plan", "packageReceipt", "evidencePack"],
      "properties": {
        "releaseId": { "const": "mkd-m1c-438e6ae583fc952d" },
        "siteDigest": { "const": "sha256:438e6ae583fc952d813908b53a6c886ef127dad56d1a73eb017151f1f38bfadf" },
        "archiveSha256": { "const": "39c46be06d37507bbb5c1470d531c80988c6bc46d1d332425b51170ff840a892" },
        "siteManifest": { "$ref": "#/$defs/fileEvidence" },
        "diffManifest": { "$ref": "#/$defs/fileEvidence" },
        "p9Plan": { "$ref": "#/$defs/fileEvidence" },
        "packageReceipt": { "$ref": "#/$defs/fileEvidence" },
        "evidencePack": { "$ref": "#/$defs/fileEvidence" }
      },
      "additionalProperties": false
    },
    "state": { "enum": ["in-review", "accepted", "rejected"] },
    "independenceRequired": { "const": true },
    "reviewers": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["roleId", "assignee", "scope", "requiredChecks", "assignmentState", "decision", "signedAt", "recordRef"],
        "properties": {
          "roleId": { "type": "string", "pattern": "^ROLE-[A-Z0-9-]+$" },
          "assignee": { "type": "string", "minLength": 2 },
          "scope": { "type": "string", "minLength": 12 },
          "requiredChecks": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 12 },
            "uniqueItems": true
          },
          "assignmentState": { "enum": ["assigned", "completed"] },
          "decision": { "enum": ["pending", "accepted", "rejected"] },
          "signedAt": {
            "anyOf": [
              { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
              { "type": "null" }
            ]
          },
          "recordRef": { "$ref": "#/$defs/fileEvidence" }
        },
        "additionalProperties": false
      }
    },
    "authorizationBoundary": {
      "type": "object",
      "required": ["localPackageReviewCompleted", "publicationAuthorized", "remoteActionsAuthorized", "publicP9Authorized", "providerCallsAuthorized", "productionAgentAuthorized", "commitAuthorized", "pushAuthorized"],
      "properties": {
        "localPackageReviewCompleted": { "type": "boolean" },
        "publicationAuthorized": { "const": false },
        "remoteActionsAuthorized": { "const": false },
        "publicP9Authorized": { "const": false },
        "providerCallsAuthorized": { "const": false },
        "productionAgentAuthorized": { "const": false },
        "commitAuthorized": { "const": false },
        "pushAuthorized": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "in-review" } }, "required": ["state"] },
      "then": {
        "properties": {
          "reviewers": {
            "items": {
              "properties": {
                "assignmentState": { "const": "assigned" },
                "decision": { "const": "pending" },
                "signedAt": { "const": null }
              }
            }
          },
          "authorizationBoundary": { "properties": { "localPackageReviewCompleted": { "const": false } } }
        }
      }
    }
  ],
  "$defs": {
    "fileEvidence": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 3 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
