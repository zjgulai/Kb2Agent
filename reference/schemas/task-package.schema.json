{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/schemas/task-package.schema.json",
  "title": "MKD L6 TaskPackage",
  "allOf": [
    { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/baseObject" },
    {
      "type": "object",
      "required": ["name", "taskContract", "requiredClosure", "skillRef", "outputSchemaRef", "evaluationRefs", "eLevel", "publicInput"],
      "properties": {
        "objectType": { "const": "TaskPackage" },
        "name": { "type": "string", "minLength": 4 },
        "taskContract": { "type": "string", "minLength": 12 },
        "requiredClosure": {
          "type": "object",
          "required": ["objectIds", "allowedRelations", "maxDepth", "maxObjects"],
          "properties": {
            "objectIds": { "type": "array", "minItems": 1, "items": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" }, "uniqueItems": true },
            "allowedRelations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 }, "uniqueItems": true },
            "maxDepth": { "type": "integer", "minimum": 1, "maximum": 4 },
            "maxObjects": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "additionalProperties": false
        },
        "skillRef": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" },
        "outputSchemaRef": { "const": "https://mkd.local/schemas/action-package.schema.json" },
        "evaluationRefs": { "type": "array", "minItems": 1, "items": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" }, "uniqueItems": true },
        "eLevel": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/publicELevel" },
        "publicInput": {
          "type": "object",
          "required": ["freeText", "fileUpload", "urlInput", "allowedParameters"],
          "properties": {
            "freeText": { "const": false },
            "fileUpload": { "const": false },
            "urlInput": { "const": false },
            "allowedParameters": { "type": "array", "items": { "type": "string", "minLength": 2 }, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
