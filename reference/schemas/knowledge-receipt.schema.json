{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/schemas/knowledge-receipt.schema.json",
  "title": "MKD KnowledgeReceipt",
  "type": "object",
  "required": ["receiptId", "runId", "mode", "evidenceGrade", "snapshot", "taskPackage", "skill", "model", "prompt", "tools", "traceRef", "evaluationRefs", "artifactHashes", "externalCalls", "sideEffects", "issuedAt"],
  "properties": {
    "receiptId": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" },
    "runId": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" },
    "mode": { "enum": ["replay", "live"] },
    "evidenceGrade": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/evidenceGrade" },
    "snapshot": { "$ref": "#/$defs/versionedRef" },
    "taskPackage": { "$ref": "#/$defs/versionedRef" },
    "skill": { "$ref": "#/$defs/versionedRef" },
    "model": { "$ref": "#/$defs/versionedRef" },
    "prompt": { "$ref": "#/$defs/versionedRef" },
    "tools": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/versionedRef" } },
    "traceRef": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" },
    "evaluationRefs": { "type": "array", "minItems": 1, "items": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" }, "uniqueItems": true },
    "artifactHashes": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/hash" } },
    "externalCalls": { "type": "integer", "minimum": 0 },
    "sideEffects": { "type": "integer", "minimum": 0 },
    "issuedAt": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/dateTime" }
  },
  "additionalProperties": false,
  "$defs": {
    "versionedRef": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 2 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
