{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mkd.local/schemas/run-trace.schema.json",
  "title": "MKD RunTrace",
  "type": "object",
  "required": ["traceId", "runId", "mode", "events", "status", "externalCalls", "sideEffects"],
  "properties": {
    "traceId": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" },
    "runId": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" },
    "mode": { "enum": ["replay", "live"] },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/event" } },
    "status": { "enum": ["completed", "blocked", "failed"] },
    "externalCalls": { "type": "integer", "minimum": 0 },
    "sideEffects": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": ["eventId", "stage", "kind", "startedAt", "durationMs", "status", "inputRefs", "outputRefs"],
      "properties": {
        "eventId": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" },
        "stage": { "enum": ["source", "evidence", "decision", "skill", "task", "agent", "receipt"] },
        "kind": { "enum": ["retrieve", "calculate", "guardrail", "draft", "evaluate", "receipt"] },
        "startedAt": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/dateTime" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["completed", "blocked", "failed"] },
        "inputRefs": { "type": "array", "items": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" }, "uniqueItems": true },
        "outputRefs": { "type": "array", "items": { "$ref": "https://mkd.local/schemas/common.schema.json#/$defs/identifier" }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
